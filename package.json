{
  "name": "invictos-inventory",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,app -c blue,gray \"npm:dev:server\" \"npm:dev:app\"",
    "dev:app": "vite",
    "dev:server": "tsx watch server/index.ts",
    "admin": "tsx server/admin.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
