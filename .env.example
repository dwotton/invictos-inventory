# Copy this file to .env and fill it in. Never commit .env or share it in chat or email.

# "sample" uses built-in sample data. "live" reads from NetSuite with the keys below.
NETSUITE_MODE=sample

# NetSuite account id. Sandbox ids end in _SB1 (e.g. 9801115_SB1); the live account is 9801115.
NETSUITE_ACCOUNT_ID=

# From the integration record (consumer) and access token your NetSuite admin creates.
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# Submitting orders from the app:
#   off            never create orders (default; safe for viewing live data)
#   on             create orders, but only on a sandbox account
#   on-production  also create orders on the live account (only after testing)
NETSUITE_ORDERS=off

# NetSuite location app orders ship from (1 = Main Warehouse).
NETSUITE_LOCATION_ID=1

# Port for the Invictos server.
PORT=8787
